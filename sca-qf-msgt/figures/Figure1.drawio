i&gt;&lt;sub&gt;c&lt;/sub&gt;), alarm if &lt;i&gt;ŷ&lt;/i&gt; &gt; δ" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontStyle=1;fontSize=13;fontColor=#000000;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="960" y="713" width="340" height="54" as="geometry"/></mxCell><mxCell id="c127" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035" y="485" as="sourcePoint"/><mxPoint x="1080" y="525" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c128" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1225" y="485" as="sourcePoint"/><mxPoint x="1180" y="525" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c129" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="579" as="sourcePoint"/><mxPoint x="1130" y="619" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c130" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="673" as="sourcePoint"/><mxPoint x="1130" y="713" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c131" value="Dashed outline: simulated quantum stage" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontStyle=1;fontSize=13;fontColor=#000000;text;rounded=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="790" width="340" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>